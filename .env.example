# 复制为仓库根目录的 .env 并填值。.env 已被 git 忽略，密钥不要提交、不要发聊天里。

# Discord 开发者后台建 Bot 后拿到的 token（必填）
DISCORD_BOT_TOKEN=
# 你的 Discord 用户 ID（必填，可多个，逗号分隔）：主人判定就靠它
OWNER_ID=
# 可选：只在这个服务器里注册命令（立即生效）；不填则注册全局命令（传播慢几分钟）
DISCORD_GUILD_ID=
# 大脑与生成用的 Gemini key（必填，免费层即可）
GEMINI_API_KEY=
# 事实核查异源 key（有就填，fact-check 会优先用它审 Gemini 的稿）
DEEPSEEK_API_KEY=
# 或 OpenCode Zen 的免费 key（opencode.ai 注册领取）：fact-check 其次用它
# 走 Zen 网关的免费 DeepSeek 审稿，generate-script 也可用 --provider opencode
OPENCODE_API_KEY=
# 可选：大脑模型，默认 gemini-3.8-flash
BRAIN_MODEL=
# 可选：演示模式限量，默认每人每天 1 条、全局每天 5 条
DEMO_PER_USER_DAILY=1
DEMO_GLOBAL_DAILY=5
